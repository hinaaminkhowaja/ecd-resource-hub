# Optional Power Automate HTTP trigger URL. Keep this secret in .env; it takes priority over SMTP.
POWER_AUTOMATE_URL=
# Optional; match this with a header check in your flow.
POWER_AUTOMATE_KEY=

# SMTP fallback, used only when POWER_AUTOMATE_URL is blank.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@example.org
SMTP_PASS=your-provider-app-password
SMTP_FROM=ECD Resource Hub <your-sending-account@example.org>
API_PORT=3001
TIME_ZONE=Asia/Karachi
