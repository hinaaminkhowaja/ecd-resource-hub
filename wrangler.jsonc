{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecd-resource-hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecd-resource-hub-db",
      "database_id": "874392ee-9973-485d-b89d-11ea6bc33735"
    }
  ]
}
